! Трекинг одиночной частицы (x0=1мм) 1 оборот — эталонная траектория для сравнения с нашим ядром.
! centroid=%s.cen пишет (Cx,Cxp,Cy,Cyp,s) на КАЖДОМ элементе; для 1 частицы центроид = её координаты.
&run_setup
    lattice = "syla_ring.lte",
    use_beamline = "RING",
    p_central_mev = 6000,
    centroid = "%s.cen",
    default_order = 1,
&end

&run_control
    n_passes = 1,
&end

! одна детерминированная частица: нулевые эмиттансы + сдвиг центроида x=+1мм
&bunched_beam
    n_particles_per_bunch = 1,
    emit_x = 0,
    emit_y = 0,
    sigma_dp = 0,
    sigma_s = 0,
    centroid[0] = 1e-3,
&end

&track &end
