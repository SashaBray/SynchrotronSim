! Трекинг x0=1мм по линии, начинающейся с QF1A (выравнивание с нашим трекером по s).
&run_setup
    lattice = "syla_ring.lte",
    use_beamline = "RING_Q",
    p_central_mev = 6000,
    centroid = "%s.cen",
    default_order = 1,
&end
&run_control
    n_passes = 1,
&end
&bunched_beam
    n_particles_per_bunch = 1,
    emit_x = 0, emit_y = 0, sigma_dp = 0, sigma_s = 0,
    centroid[0] = 5e-3,
&end
&track &end
