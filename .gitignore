# Сборка
build/
bin/
obj/
*.exe
*.obj
*.pdb

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Данные и результаты (большие бинарные)
workspace/fields_bin/
workspace/fields_raw/
# упорядоченные ссылки на карты для модели насыщения (жёсткие ссылки, место не занимают)
workspace/fields_model/
workspace/results/
*.bak

# Research-выходы (датасеты/отчёты/фигуры — регенерируются кодом, ~72М)
workspace/research/

# Транзиентные бэкапы БД (варианты .bak_* / .pre_*)
*.bak_*
*.pre_*

# Сгенерированные из LTE таблицы (восстанавливаются через lte_to_lattice.py
# и assemble_lattice_configs.py)
workspace/tables/sp_elements.csv
workspace/tables/lattice_layout.csv
workspace/tables/lattice_configs.csv

# Таблица матриц связи ток→физкоэф (генерируется element_compare.py library)
workspace/tables/coupling_matrices.csv

# Проектные токи обмоток (производная от матриц связи, генерируется design_currents.py)
workspace/tables/design_currents.csv

# Отпечатки входных данных матриц связи (пишутся вместе с coupling_matrices.csv, он тоже игнорится)
workspace/tables/coupling_matrices.inputs.json

# Рабочая копия 4 таблиц на время прогона element_compare (страховка от прерывания)
workspace/tables/_cmp_backup/

# Реестр проектов графической оболочки (у каждого свой)
workspace/configs/gui_projects.json

# Ярлыки запуска: хранят абсолютные пути машины (пересоздаются make_shortcut.py)
*.lnk

# Сгенерированные optimconfig (производные от JSON)
workspace/optim_inputs/*.optimconfig

# 3D-модели (большие binary)
workspace/geometry/*.stl
workspace/geometry/*.obj

# IDE
.vscode/
.idea/
*.user
*.swp
.DS_Store

# Markdown файлы (документация ведётся в plain README и в docs/)
*.md
*.MD
# ...кроме README.md и всего, что в docs/
!README.md
!docs/
!docs/**/*.md

# Файлы Claude (агенты, контекст, сессии, плагины)
.claude/
.claude*
claude/
*claude*
*CLAUDE*
AGENTS.md
agents.md
ARCHITECTURE.md

# Резервные копии вручную
workspace/tables/sp_elements*копия*.csv

# Локальный лабораторный журнал исследований (личные заметки)
research_log/

# Бэкапы БД (транзиентные)
workspace/tables/backups/

# elegant: установка (80МБ) и бинарные выходы прогонов — в репо не нужны
elegant/
elegant_run/*.flr
elegant_run/*.cen
elegant_run/*.twi
elegant_run/*.mag
elegant_run/*.mat
elegant_run/*.log

# временные снимки таблиц
workspace/tables/*.tmp
workspace/tables/*.leff_tuned

# сверка траекторий: архивы (генерируемые) и временные файлы elegant
workspace/results/traj_compare/
elegant_run/_trajcmp.*

# gap-эксперимент (одноразовая диагностика дисперсии) и доп. снимки БД
workspace/lte/configuration_v1_gap/
elegant_run/syla_gap.lte
elegant_run/gap_track.*
elegant_run/sp1_gap_elegant.txt
workspace/tables/snapshot_closed/

# кэш разложения карт (перестраивается build_kick_datasets.py, ~200 КБ машинного JSON)
workspace/datasets/**/_harmonics_cache.json

# отложенные к удалению данные и папка экспорта AEDT — большие, не для репозитория
workspace/_на_удаление/
workspace/aedt_exports/
# сверка с elegant: всё в elegant_run/diag генерируется elegant_diag.py / verify_elegant.py
elegant_run/diag/

# --- добавлено при подготовке к публикации ---
# 3D-модели: любой регистр расширения и вложенные папки (synthetic/*.STL обходили *.stl)
*.stl
*.STL
*.obj
*.OBJ
workspace/geometry/

# Справочные PDF (статьи/КД — не в репозиторий)
*.pdf
*.PDF

# Рабочие/сгенерированные прогоны elegant новых решёток и диагностика
elegant_run/newlat/
elegant_run/*.sdds
elegant_run/*.ele

# Бэкапы с суффиксом через дефис (*.bak_* уже есть, добавляем *.bak-*)
*.bak-*
